# Central Identity API: preferred name, then legacy alias, then localhost default.
VITE_CENTRAL_IDENTITY_API_URL=http://localhost:8080/api/v1
# VITE_IDENTITY_API_BASE_URL=http://localhost:8080/api/v1

# LMS Instance API: preferred name, then legacy alias, then localhost default.
VITE_LMS_API_URL=http://localhost:8081/api/v1
# VITE_LMS_API_BASE_URL=http://localhost:8081/api/v1

# LMS is the default. Provision an active client and register this exact URI
# in Central Identity before filling these values. No sample client is seeded.
VITE_AUTH_MODE=lms
VITE_LMS_CLIENT_ID=
VITE_LMS_REDIRECT_URI=
# Example only: VITE_LMS_CLIENT_ID=g11-lms
# Example only: VITE_LMS_REDIRECT_URI=http://localhost:5173/

# For explicit Central Identity standalone login, use VITE_AUTH_MODE=standalone
# and leave BOTH LMS context variables above empty or unset.
# VITE_* values are public build-time configuration; rebuild before preview.
